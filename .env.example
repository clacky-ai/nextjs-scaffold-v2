# Database
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:your_password@127.0.0.1:5432/your_database_name"

# NextAuth.js for Users
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Admin Auth
ADMIN_NEXTAUTH_SECRET="your-admin-secret-key-here-change-in-production"
